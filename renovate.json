{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>eolhq/workflows:renovate-config"],
  "customManagers": [
    {
      "description": "The manylinux build image is pinned in an env var, which no built-in manager reads.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: \\S+?:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]+)"
      ]
    }
  ]
}
